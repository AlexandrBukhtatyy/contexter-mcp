{
  "name": "mcp-context",
  "version": "0.1.0",
  "description": "MCP-сервер контекста задачи: поиск по Markdown-документации, коду и контрактам с объяснимыми связями",
  "type": "module",
  "private": true,
  "bin": {
    "mcp-context": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "mcp-context": "node --disable-warning=ExperimentalWarning src/cli/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ignore": "^7.0.16",
    "picomatch": "^4.0.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "snowball-stemmers": "^0.6.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.15.0",
    "typescript-eslint": "^8.73.0"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  }
}
